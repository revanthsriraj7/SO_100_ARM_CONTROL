# colcon workspace build output -- regenerated by `colcon build`, never
# committed. This also covers the case of colcon accidentally being run
# from inside a package directory instead of the workspace root (which is
# how so101_dashboard ended up with its own build/, log/ before).
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
